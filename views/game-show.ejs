<%- include('partials/header', { title: title }) %>
<section class="card hero compact-hero">
  <div>
    <p class="eyebrow">Game summary</p>
    <h2>Game #<%= game.id %></h2>
    <p class="lede">Played on <%= game.playedOn %><% if (game.notes) { %> · <%= game.notes %><% } %></p>
    <p class="mini-summary">Status: <%= game.isCompleted ? 'Completed' : 'In progress' %></p>
  </div>
  <div class="stat-grid compact">
    <article class="stat-card">
      <span>Winner</span>
      <strong><%= winners.length > 1 ? 'Tie' : (winner ? winner.playerName : 'N/A') %></strong>
    </article>
    <article class="stat-card">
      <span>Best total</span>
      <strong><%= winner ? winner.score : 'N/A' %></strong>
    </article>
  </div>
</section>

<section class="card">
  <div class="actions actions-inline">
    <a class="button" href="/games/<%= game.id %>/hands"><%= game.isCompleted ? 'View hand history' : 'Continue recording hands' %></a>
    <% if (!game.isCompleted) { %>
      <form method="post" action="/games/<%= game.id %>/finish" onsubmit="return confirm('Finish this game and lock in the winner?');">
        <button class="button" type="submit">Finish game</button>
      </form>
    <% } %>
    <form method="post" action="/games/<%= game.id %>/delete" onsubmit="return confirm('Delete this game and all scores?');">
      <button class="button button-danger" type="submit">Delete game</button>
    </form>
  </div>
</section>

<section class="card">
  <div class="card-head">
    <h3>Scores</h3>
    <span>Lower is better</span>
  </div>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Player</th>
          <th>Score</th>
        </tr>
      </thead>
      <tbody>
        <% scores.forEach(function (score) { %>
          <tr class="<%= winner && score.playerId === winner.playerId ? 'winner-row' : '' %>">
            <td><%= score.playerName %></td>
            <td><%= score.score %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
  <% if (winners.length > 1) { %>
    <p class="mini-summary">Tie between: <%= winners.map(function (w) { return w.playerName; }).join(', ') %></p>
  <% } %>
</section>
<%- include('partials/footer') %>